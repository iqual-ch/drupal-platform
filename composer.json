{
    "name": "iqual/drupal-platform",
    "description": "Project asset package for the iqual internal developer platform's Drupal integration.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "martinstadelmann",
            "email": "m.stadelmann@iqual.ch"
        }
    ],
    "require": {
        "iqual/project-scaffold": "^1.1"
    },
    "archive": {
        "exclude": ["/docs"]
    },
    "bin": [
        "bin/ddev-shim-php",
        "bin/ddev-shim-phpcbf-ext",
        "bin/ddev-shim-phpcs-ext"
    ],
    "extra": {
        "project-scaffold": {
            "runtime": {
                "php_version": 8.3,
                "db_version": 10.6,
                "solr_version": null
            },
            "workflows": {
                "update": true,
                "upgrade": true,
                "vrt": true,
                "phpunit": false
            },
            "deployment": "platform.sh",
            "platformsh_config": {
                "region": "ch-1",
                "project_id": ""
            },
            "drupal_spot": "main-bvxea6i",
            "assets": {
                "add": "assets/add",
                "replace": "assets/replace",
                "merge": "assets/merge",
                "read": "questions.json"
            }
        }
    }
}
