{% if workflows.vrt %}
name: Visual Regression testing

{% if workflows.phpunit %}
{% verbatim -%}
on:
  workflow_dispatch:
  workflow_call:
    inputs:
      database-cache-key:
        default: "${{ github.sha }}"
        type: string

jobs:
  run-vr-tests:
    name: Visual Regression tests
    runs-on: ubuntu-latest

    steps:
    - name: Checkout
      uses: actions/checkout@v5

    - name: Install Drupal locally
      uses: ./.github/actions/install-local
      with:
        ssh_key: ${{ secrets.SSH_KEY }}
        caching: true
        caching_db_key: ${{ inputs.database-cache-key || github.sha }}

    - name: Run Visual regression tests
      uses: ./app/vendor/iqual-ch/ci-pocketknife-installer/.github/actions/visual-regression-tests
{% endverbatim -%}
{% else %}
{% verbatim -%}
on:
  workflow_dispatch:
  pull_request:
    types: [opened, reopened]

jobs:
  run-vr-tests:
    name: Visual Regression tests
    runs-on: ubuntu-latest

    steps:
    - name: Checkout
      uses: actions/checkout@v5

    - name: Install Drupal locally
      uses: ./.github/actions/install-local
      with:
        ssh_key: ${{ secrets.SSH_KEY }}

    - name: Run Visual regression tests
      uses: ./app/vendor/iqual-ch/ci-pocketknife-installer/.github/actions/visual-regression-tests
{% endverbatim -%}
{% endif %}
{% endif %}
