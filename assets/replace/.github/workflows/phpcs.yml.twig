{% if workflows.phpunit %}
name: PHPCS

env:
  PHP_VERSION: "{{ runtime.php_version }}"

{% verbatim -%}
on:
  workflow_dispatch:
  workflow_call:

concurrency:
  group: ci-lint-${{ github.ref }}
  cancel-in-progress: true

jobs:
  lint:
    name: "Linting"
    runs-on: ubuntu-latest

    steps:
    - name: Checkout
      uses: actions/checkout@v6

    - name: "Set up PHP"
      uses: shivammathur/setup-php@v2
      with:
        extensions: "gd, imagick, bcmath"
        php-version: "${{ env.PHP_VERSION }}"
        tools: parallel-lint, cs2pr

    - name: Prepare environment
      shell: bash
      run: |
        echo "::add-matcher::${{ runner.tool_cache }}/php.json"
        echo "REPO_CODE=$(git ls-tree -d -r $(git write-tree) --name-only | grep -E '(themes|modules)/custom/[^/]+$$' | paste -s -)" >> $GITHUB_ENV

    - name: "Run PHP parallel lint"
      shell: bash
      run: |
        parallel-lint ${REPO_CODE} -e php,module,theme,inc,install,profile --no-progress

    - name: "Install dependencies"
      shell: bash
      run: |
        composer install --ansi --no-interaction --no-progress --working-dir="./app"
        echo "${{ github.workspace }}/app/vendor/bin" >> $GITHUB_PATH

    - name: "Run PHPCS"
      shell: bash
      run: |
        phpcs \
          --standard=./app/phpcs.xml.dist \
          --runtime-set ignore_warnings_on_exit 1 \
          --report=checkstyle \
          -q \
          ${REPO_CODE} \
          | cs2pr --graceful-warnings

{% endverbatim -%}
{% endif %}
